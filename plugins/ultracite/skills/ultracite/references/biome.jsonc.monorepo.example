{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  // Monorepo root configuration
  // Single config applies to all packages
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],  // v7 paths

  // Optional: Customize formatter
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "lineWidth": 100
  },

  // Optional: Customize linter
  "linter": {
    "enabled": true
  },

  // Exclude common monorepo build outputs (Biome 2.x: files.includes with ! negation)
  "files": {
    "includes": [
      "**",
      // Package managers
      "!node_modules",
      "!.pnpm-store",

      // Build outputs
      "!dist",
      "!build",
      "!.next",
      "!out",
      "!.turbo",
      "!.cache",

      // Testing
      "!coverage",

      // Generated
      "!**/*.generated.ts",
      "!**/__generated__/**"
    ]
  },

  // Package-specific overrides (Biome 2.x: overrides[].includes)
  "overrides": [
    {
      // Legacy package with relaxed rules
      "includes": ["packages/legacy/**"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "warn",
            "noVar": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn"
          }
        }
      }
    },
    {
      // Next.js app
      "includes": ["apps/web/**"],
      "extends": ["ultracite/biome/next"],  // v7 path
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "error"
          }
        }
      }
    },
    {
      // Node.js API (no React)
      "includes": ["apps/api/**"],
      "extends": ["ultracite/biome/core"],  // v7 path
      "javascript": {
        "globals": ["process", "Buffer", "__dirname", "__filename"]
      }
    },
    {
      // Shared UI components
      "includes": ["packages/ui/**"],
      "extends": ["ultracite/biome/react"],  // v7 path
      "linter": {
        // Biome 2.x: per-rule "*" / group "all" shortcuts were removed;
        // enable explicit a11y rules or use linter.domains: { "react": "all" }
        "rules": {
          "a11y": {
            "useAltText": "error",
            "useAnchorContent": "error",
            "useButtonType": "error",
            "useKeyWithClickEvents": "error"
          }
        }
      }
    },
    {
      // Test files
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
